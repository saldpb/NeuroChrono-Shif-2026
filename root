<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NeuroChrono | Sub-Perceptual Threat Gating BCI Dashboard</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --border: #334155;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --threat: #ef4444;
      --neutral: #3b82f6;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding: 2rem 1rem;
    }
    .container { max-width: 1180px; margin: 0 auto; }
    header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
    h1 { font-size: 1.9rem; color: var(--accent); margin-bottom: 0.4rem; }
    .subtitle { color: var(--muted); font-size: 1rem; }
    .badge-row { margin-top: 0.9rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .badge {
      background: var(--card);
      border: 1px solid var(--border);
      padding: 0.25rem 0.7rem;
      border-radius: 999px;
      font-size: 0.8rem;
      color: var(--text);
    }
    h2 {
      font-size: 1.35rem;
      margin: 2rem 0 1rem;
      border-left: 4px solid var(--accent);
      padding-left: 0.75rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(520px, 1fr));
      gap: 1.5rem;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .card h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
    .card p { font-size: 0.88rem; color: var(--muted); margin-bottom: 0.9rem; }
    .card img {
      width: 100%;
      border-radius: 6px;
      background: #ffffff;
      border: 1px solid var(--border);
      cursor: zoom-in;
    }
    .card-footer {
      margin-top: 0.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
    }
    a.btn {
      display: inline-block;
      background: var(--accent);
      color: #0f172a;
      font-weight: 600;
      text-decoration: none;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.8rem;
      margin-right: 0.35rem;
    }
    a.btn:hover { opacity: 0.9; }
    .tensor-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem;
    }
    .tensor-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 1rem;
      margin: 1rem 0;
    }
    .stat {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.85rem;
    }
    .stat-label { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; }
    .stat-val { font-size: 1.15rem; font-weight: 700; color: var(--accent); margin-top: 0.2rem; }
    canvas {
      width: 100%;
      height: 240px;
      background: #0b1120;
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-top: 1rem;
    }
    .controls { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 1rem; }
    select, input[type="number"] {
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
    }
    .class-pill {
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .pill-threat { background: rgba(239, 68, 68, 0.18); color: #fca5a5; border: 1px solid var(--threat); }
    .pill-neutral { background: rgba(59, 130, 246, 0.18); color: #93c5fd; border: 1px solid var(--neutral); }
    .pill-unknown { background: rgba(148, 163, 184, 0.15); color: var(--muted); border: 1px solid var(--border); }
    @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  </style>
